#!/bin/sh
# tintcoat -- terminal color themes, applied to the session you are already in.
#
# This is a launcher, not the program. It resolves the checkout directory and
# picks an interpreter: zsh if present, otherwise bash 4 or newer. macOS ships
# bash 3.2, which lacks the associative arrays the implementation relies on, so
# it is skipped in favor of anything newer found on PATH.

set -e

# Resolve this script through any symlinks, so `ln -s .../bin/tintcoat ~/bin/tintcoat`
# still finds lib/ and themes/ next door.
self=$0
while [ -h "$self" ]; do
  link=$(readlink "$self")
  case $link in
    /*) self=$link ;;
    *)  self=$(dirname "$self")/$link ;;
  esac
done
TINTCOAT_ROOT=$(cd -- "$(dirname "$self")/.." && pwd -P)
export TINTCOAT_ROOT

pick_shell() {
  # An explicit choice wins -- the test suite uses it to run the whole suite
  # once per shell.
  if [ -n "${TINTCOAT_SHELL:-}" ]; then
    printf '%s' "$TINTCOAT_SHELL"; return 0
  fi

  if command -v zsh >/dev/null 2>&1; then
    printf 'zsh'; return 0
  fi

  # bash >= 4, wherever it lives. On macOS /bin/bash is 3.2 and unusable, but
  # Homebrew's is normally earlier on PATH anyway.
  for cand in bash /opt/homebrew/bin/bash /usr/local/bin/bash /bin/bash; do
    b=$(command -v "$cand" 2>/dev/null) || continue
    major=$("$b" -c 'echo ${BASH_VERSINFO[0]}' 2>/dev/null) || continue
    case $major in
      ''|*[!0-9]*) continue ;;
    esac
    if [ "$major" -ge 4 ]; then printf '%s' "$b"; return 0; fi
  done
  return 1
}

if ! sh_bin=$(pick_shell); then
  cat >&2 <<'EOF'
tintcoat needs zsh, or bash 4 or newer.

macOS still ships bash 3.2, which cannot run this. Either is fine:
    brew install zsh
    brew install bash
EOF
  exit 1
fi

exec "$sh_bin" "$TINTCOAT_ROOT/lib/main.sh" "$@"
